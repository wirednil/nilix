<?xml version="1.0" encoding="UTF-8"?>
<form id="mf_pedidos" title="Pedidos (fixture multifield)" database="app" table="mf_pedidos" handler="none">

    <layout>
        <field id="id" label="N°" type="number" keyField="true" size="5"/>

        <field id="items" label="Items" type="multifield" rows="10" display="1" item-label="item">
            <field id="id_producto" label="Producto" type="select" size="6">
                <validation>
                    <in-table table="mf_productos" key="id" display="nombre">
                        <copy from="nombre" to="producto"/>
                    </in-table>
                </validation>
            </field>
            <field id="producto" label="Nombre" type="text" size="20" readonly="true" skip="true"/>
            <field id="precio_unitario" label="Precio unit." type="choice" size="14">
                <validation>
                    <choice default-from="precio_menor">
                        <option from="precio_mayor" suffix="(x mayor)"/>
                        <option from="precio_menor" suffix="(x menor)"/>
                    </choice>
                </validation>
            </field>
        </field>
    </layout>
</form>
