<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture — form con <output> (comprobante post-guardado) y un handler cuyo
  validate() devuelve mensajes propios. Replica el flujo de ventas.xml de
  thym-pos: registrar, ver el comprobante, volver al form limpio. Ver
  tests/e2e.test.js #22-#23 y dev/apps/comprobante_fixture.handler.js.
-->
<form id="comprobante_fixture" title="Comprobante (fixture)" database="app" table="comprobante_fixture" handler="comprobante_fixture">
    <output report="comprobante_fixture" param="id" on="create"/>

    <layout>
        <field id="id" label="N°" type="number" keyField="true" size="5"/>
        <field id="nombre" label="Nombre" type="text" size="30"/>
        <field id="id_producto" label="Producto" type="select" size="6">
            <validation>
                <in-table table="mf_productos" key="id" display="nombre">
                    <copy from="nombre" to="nombre_producto"/>
                </in-table>
            </validation>
        </field>
        <field id="nombre_producto" label="Nombre producto" type="text" size="20" readonly="true" skip="true"/>
        <field id="monto" label="Monto" type="number" size="10"/>
    </layout>
</form>
