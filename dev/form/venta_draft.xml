<?xml version="1.0" encoding="UTF-8"?>
<form id="venta_draft" title="Venta borrador (fixture)" database="app" table="venta_draft" handler="venta_draft">

    <layout>
        <field id="id" label="N°" type="number" keyField="true" size="5"/>
        <field id="fecha" label="Fecha" type="date">
            <default>today</default>
        </field>

        <field id="items" label="Items" type="multifield" rows="10" display="5" item-label="item">
            <field id="id_producto" label="Producto" type="select" size="6">
                <validation>
                    <in-table table="mf_productos" key="id" display="nombre">
                        <copy from="nombre" to="producto"/>
                    </in-table>
                </validation>
            </field>
            <field id="producto" label="Nombre" type="text" size="20" readonly="true" skip="true"/>
            <field id="cantidad" label="Cantidad" type="number" size="6">
                <default>1</default>
                <check>this &gt;= 1</check>
            </field>
            <field id="precio_unitario" label="Precio unit." type="choice" size="14">
                <validation>
                    <choice default-from="precio_menor">
                        <option from="precio_mayor" suffix="(x mayor)"/>
                        <option from="precio_menor" suffix="(x menor)"/>
                    </choice>
                </validation>
            </field>
            <field id="precio_total" label="Subtotal" type="number" size="10" is="precio_unitario * cantidad" readonly="true" skip="true"/>
        </field>

        <field id="total" label="Total" type="number" size="12" is="sum(precio_total)" readonly="true"/>
    </layout>
</form>
