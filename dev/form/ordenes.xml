<?xml version="1.0" encoding="UTF-8"?>
<form id="ordenes" title="Órdenes de Clientes" database="app" table="ordenes" handler="none">

    <form-attributes>
        <messages>
            <message id="HELP_ORDERNO">Número de orden — clave primaria</message>
            <message id="HELP_CLIENO">Número de cliente — busca en tabla de clientes</message>
            <message id="HELP_FENTR">Fecha de entrega prevista</message>
        </messages>
    </form-attributes>

    <layout>

        <container type="horizontal">
            <field id="orderno" label="N° Orden" type="number" keyField="true" size="5">
                <help>HELP_ORDERNO</help>
                <validation><min>1</min></validation>
            </field>
            <field id="fecha" label="Fecha" type="date">
                <default>today</default>
            </field>
        </container>

        <container type="horizontal">
            <field id="clieno" label="Cliente" type="number" size="5">
                <help>HELP_CLIENO</help>
                <in-table table="clientes" key="clieno" display="nombre">
                    <copy from="nombre" to="clie_nom"/>
                </in-table>
            </field>
            <field id="clie_nom" label="Nombre" type="text" size="30"
                   readonly="true" skip="true"/>
        </container>

        <field id="valor" label="Valor" type="number" size="12"/>

        <container type="horizontal">
            <!--
              La validación "fecha de entrega >= fecha de orden" NO se hace acá con <check>:
              <check> compara dos campos type="date" haciendo parseFloat() sobre un objeto Date,
              lo que da NaN->0 y la comparación siempre resulta true (verificado en vivo contra
              ExpressionEngine.js — ver docs/03-reference/nil-form.md, sección "Atributos de Check").
              Si esta validación se vuelve necesaria, va en un handler (beforeSave), no en el XML.
            -->
            <field id="fentr" label="Fecha Entrega" type="date">
                <help>HELP_FENTR</help>
                <default>today</default>
            </field>
            <field id="mentr" label="Modo Entrega" type="select">
                <options>
                    <option value="0">Retira el cliente</option>
                    <option value="1">Flete propio</option>
                    <option value="2">Flete del cliente</option>
                </options>
            </field>
        </container>

        <field id="direc" label="Dirección entrega / Empresa flete" type="text" size="50"/>

    </layout>

</form>
